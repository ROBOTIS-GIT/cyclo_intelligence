########################################
# Internal Policy Runtime <-> Engine process commands
########################################
# Hosted by a Worker Engine process at /<runtime>/engine_command.
# External clients use /policy/inference_command.

uint8 LOAD_POLICY   = 0
uint8 GET_ACTION    = 1
uint8 UNLOAD_POLICY = 2
uint8 DESCRIBE      = 3
uint8 STATUS        = 4

uint8 command

# Monotonic request id generated by Policy Runtime. Engine echoes it back so
# late/stale responses can be discarded after a configurable timeout.
uint64 seq_id

# LOAD_POLICY fields.
string model_path
string embodiment_tag
string robot_type
string task_instruction
string acceleration_mode
string acceleration_engine_path
# Validated by Policy Runtime before forwarding to Engine.
string policy_id
string policy_parameters_json
---
uint64 seq_id
bool success
string message

# LOAD_POLICY response.
string[] action_keys

# GET_ACTION response. action_list is row-major:
# chunk_size * action_dim == len(action_list).
int32 chunk_size
int32 action_dim
float64[] action_list

# Worker compatibility and health metadata. Populated by DESCRIBE/STATUS.
string protocol_version
string runtime_id
string worker_instance_id
string[] supported_policy_ids
string capabilities_json
string engine_state
