########################################
# Internal Main <-> Engine process commands
########################################
# Hosted by the policy container's Engine process at /<backend>/engine_command.
# External clients should keep using /<backend>/inference_command.

uint8 LOAD_POLICY   = 0
uint8 GET_ACTION    = 1
uint8 UNLOAD_POLICY = 2

uint8 command
# GR00T MLP update commands forwarded by Main, with unchanged wire fields:
# 8=status, 9=auto apply on, 10=auto apply off, 11=queue manual apply,
# 12=async RL on, 13=async RL off, 14=select Async RL datasets, 15=save bundle.
# rlt_bundle_path is the expected loaded bundle; message contains JSON status.

# Monotonic request id generated by Main. Engine echoes it back so Main can
# discard late/stale responses after a configurable timeout.
uint64 seq_id

# LOAD_POLICY fields.
string model_path
string embodiment_tag
string robot_type
# LOAD_POLICY safety context. false permits simulation/preview. true requires
# a deployment-qualified TT-RTC checkpoint before the Engine loads it.
bool publish_to_robot
string task_instruction
string acceleration_mode
string acceleration_engine_path
# LOAD_POLICY-only RLT preload settings.
bool rlt_enabled
string rlt_bundle_path
string[] rlt_dataset_paths
uint32 rlt_max_updates
# GET_ACTION router selection ("base" or "rlt"). Sync/async switch at a
# drained chunk boundary; TT-RTC preserves the committed prefix and switches
# atomically when the selected route's continuation is enqueued.
string action_policy_mode

# GET_ACTION timing contract. TT-RTC carries the exact unconsumed source-rate
# action prefix to the Engine. rtc_prefix_action_list is row-major:
# rtc_delay_steps * rtc_action_dim == len(rtc_prefix_action_list).
string action_request_mode
int32 rtc_delay_steps
int32 rtc_action_dim
float64[] rtc_prefix_action_list
---
uint64 seq_id
bool success
string message

# LOAD_POLICY response.
string[] action_keys

# GET_ACTION response. action_list is row-major:
# chunk_size * action_dim == len(action_list).
int32 chunk_size
int32 action_dim
float64[] action_list
