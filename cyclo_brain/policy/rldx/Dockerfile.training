# Build context is an immutable Cyclo policy snapshot and its pinned RLDX gitlink.
# Inference services, ROS and LeRobot are deliberately absent from this image.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG FLASH_ATTN_CUDA_ARCHS=120
ARG MAX_JOBS=2
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 curl ca-certificates git build-essential ffmpeg libegl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv
COPY upstream/ /rldx/
COPY policy/scripts/install_environment.py /opt/cyclo-training/install_environment.py
RUN FLASH_ATTENTION_FORCE_BUILD=TRUE FLASH_ATTN_CUDA_ARCHS=${FLASH_ATTN_CUDA_ARCHS} MAX_JOBS=${MAX_JOBS} \
    python3 /opt/cyclo-training/install_environment.py /rldx /opt/rldx-env
# Cyclo's per-episode v3→v2.1 converter reads and writes Parquet.
RUN uv pip install --python /opt/rldx-env/bin/python pyarrow==19.0.1
ENV PATH=/opt/rldx-env/bin:$PATH PYTHONPATH=/rldx:/opt/cyclo-training
COPY policy/scripts/prepare_dataset.py /opt/cyclo-training/prepare_dataset.py
COPY policy/scripts/modality_config.py /opt/cyclo-training/modality_config.py
COPY policy/scripts/checkpoint_smoke.py /opt/cyclo-training/checkpoint_smoke.py
COPY policy/scripts/train.sh /opt/cyclo-training/train.sh
COPY policy/scripts/train_run.py /opt/cyclo-training/train_run.py
RUN python -m compileall -q /opt/cyclo-training \
    && python -c 'import rldx; import pandas; import pyarrow; import huggingface_hub'
WORKDIR /rldx
ENTRYPOINT ["/opt/rldx-env/bin/python"]
