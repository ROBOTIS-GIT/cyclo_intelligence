# Build context is an immutable Cyclo policy snapshot and its pinned RLDX gitlink.
# Inference services, ROS and LeRobot are deliberately absent from this image.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG FLASH_ATTN_CUDA_ARCHS=120
ARG MAX_JOBS=2
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 curl ca-certificates git build-essential ffmpeg libegl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/prefix-dev/pixi@sha256:653a58cc20e0c23ada2681b4d166b3e6fea8552fd58a91bdb159693cd0509feb /usr/local/bin/pixi /usr/local/bin/pixi
COPY upstream/ /rldx/
COPY policy/scripts/install_training_environment.py /opt/cyclo-training/install_training_environment.py
COPY policy/training/environment.toml /opt/cyclo-training/environment.toml
RUN FLASH_ATTN_CUDA_ARCHS=${FLASH_ATTN_CUDA_ARCHS} MAX_JOBS=${MAX_JOBS} \
    python3 /opt/cyclo-training/install_training_environment.py /rldx \
    --policy /opt/cyclo-training/environment.toml
ENV PATH=/rldx/.pixi/envs/rldx/bin:$PATH PYTHONPATH=/rldx:/opt/cyclo-training
COPY policy/scripts/modality_config.py /opt/cyclo-training/modality_config.py
COPY policy/scripts/checkpoint_smoke.py /opt/cyclo-training/checkpoint_smoke.py
COPY policy/scripts/train.sh /opt/cyclo-training/train.sh
COPY policy/scripts/train_run.py /opt/cyclo-training/train_run.py
RUN python -m compileall -q /opt/cyclo-training \
    && python -c 'import rldx; import pandas; import pyarrow; import huggingface_hub'
WORKDIR /rldx
ENTRYPOINT ["/rldx/.pixi/envs/rldx/bin/python"]
