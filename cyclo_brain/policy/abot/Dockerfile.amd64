# Build context: repository root. ABot does not share LeRobot dependencies.
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04
ARG S6_OVERLAY_VERSION=3.2.0.2
ARG FLASH_ATTN_CUDA_ARCHS=120
ARG MAX_JOBS=2
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 curl ca-certificates git build-essential ffmpeg libegl1 libglib2.0-0 xz-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv
RUN curl -fsSL https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz -o /tmp/s6-noarch.tar.xz \
    && curl -fsSL https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz -o /tmp/s6-arch.tar.xz \
    && tar -C / -Jxf /tmp/s6-noarch.tar.xz && tar -C / -Jxf /tmp/s6-arch.tar.xz \
    && rm /tmp/s6-*.tar.xz
RUN uv venv --python 3.10 /opt/abot-env \
    && uv pip install --python /opt/abot-env/bin/python \
    --index-url https://download.pytorch.org/whl/cu128 torch==2.8.0 torchvision==0.23.0
ENV PATH=/opt/abot-env/bin:$PATH
COPY cyclo_brain/policy/abot/requirements-inference.txt /opt/requirements-inference.txt
RUN uv pip install --python /opt/abot-env/bin/python -r /opt/requirements-inference.txt \
    setuptools==80.9.0 wheel ninja packaging \
    && FLASH_ATTENTION_FORCE_BUILD=TRUE FLASH_ATTN_CUDA_ARCHS=${FLASH_ATTN_CUDA_ARCHS} MAX_JOBS=${MAX_JOBS} \
    uv pip install --python /opt/abot-env/bin/python flash-attn==2.8.3 --no-build-isolation --no-deps
# VGGT is imported by upstream even when framework.use_vggt is false.
RUN uv pip install --python /opt/abot-env/bin/python --no-deps \
    'git+https://github.com/facebookresearch/vggt.git@a288dd0f14786c93483e45524328726ab7b1b4ce'
COPY cyclo_brain/policy/abot/ABot-Manipulation/ /abot/
COPY cyclo_brain/policy/abot/abot_engine/ /app/abot_engine/
COPY cyclo_brain/policy/abot/configs/ /app/configs/
COPY cyclo_brain/policy/abot/manifest.yaml /app/policy_manifest.yaml
COPY cyclo_brain/policy/common/runtime/ /policy_runtime/
COPY cyclo_brain/policy/common/catalog/ /catalog/
COPY cyclo_brain/sdk/zenoh_ros2_sdk/ /zenoh_sdk/
COPY cyclo_brain/sdk/robot_client/ /robot_client_sdk/
COPY shared/shared/robot_configs/ /orchestrator_config/
COPY cyclo_brain/policy/common/s6-services/ /etc/s6-overlay/s6-rc.d/
RUN chmod +x /etc/s6-overlay/s6-rc.d/engine-process/run
ENV POLICY_BACKEND=abot POLICY_ENGINE_MODULE=abot_engine
ENV ZENOH_SDK_PATH=/zenoh_sdk ROBOT_CLIENT_SDK_PATH=/robot_client_sdk
ENV ORCHESTRATOR_CONFIG_PATH=/orchestrator_config
ENV HF_HOME=/root/.cache/huggingface PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:/policy_runtime:/zenoh_sdk:/robot_client_sdk:/abot
RUN python -c 'from ABot.model.framework.ABot_M0 import ABot_M0; from abot_engine import create_engine'
WORKDIR /app
ENTRYPOINT ["/init"]
