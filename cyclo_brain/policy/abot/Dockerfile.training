# Build context: Cyclo repository root. No ROS processes are started by this image.
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04@sha256:4b9ed5fa8361736996499f64ecebf25d4ec37ff56e4d11323ccde10aa36e0c43
ARG FLASH_ATTN_CUDA_ARCHS=120
ARG MAX_JOBS=2
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 curl ca-certificates git build-essential ffmpeg libegl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.21@sha256:d5f9251169d92c6b547266079bd0570ae343a853244a16be5e43b119ca56b02b /uv /usr/local/bin/uv
RUN uv venv --python 3.10.18 /opt/abot-env
ENV PATH=/opt/abot-env/bin:$PATH
COPY cyclo_brain/policy/abot/training/requirements.lock /opt/abot-build/requirements.lock
RUN uv pip sync --python /opt/abot-env/bin/python --require-hashes \
    --extra-index-url https://download.pytorch.org/whl/cu128 --index-strategy unsafe-best-match \
    /opt/abot-build/requirements.lock
RUN FLASH_ATTENTION_FORCE_BUILD=TRUE FLASH_ATTN_CUDA_ARCHS=${FLASH_ATTN_CUDA_ARCHS} MAX_JOBS=${MAX_JOBS} \
    uv pip install --python /opt/abot-env/bin/python --no-build-isolation --no-deps \
    'https://files.pythonhosted.org/packages/3b/b2/8d76c41ad7974ee264754709c22963447f7f8134613fd9ce80984ed0dab7/flash_attn-2.8.3.tar.gz#sha256=1e71dd64a9e0280e0447b8a0c2541bad4bf6ac65bdeaa2f90e51a9e57de0370d'
# Imported by upstream even with VGGT disabled. Dependencies come only from our lock.
RUN uv pip install --python /opt/abot-env/bin/python --no-deps --no-build-isolation \
    'git+https://github.com/facebookresearch/vggt.git@a288dd0f14786c93483e45524328726ab7b1b4ce'
COPY cyclo_brain/policy/abot/ABot-Manipulation/ /abot/
COPY cyclo_brain/policy/abot/abot_engine/ /opt/cyclo-training/abot_engine/
COPY cyclo_brain/policy/abot/abot_training/ /opt/cyclo-training/abot_training/
COPY cyclo_brain/policy/abot/training_profiles/ /opt/cyclo-training/training_profiles/
COPY cyclo_brain/policy/abot/scripts/train_run.py /opt/cyclo-training/train_run.py
COPY cyclo_brain/policy/abot/training/ /opt/abot-build/training/
COPY cyclo_brain/policy/abot/requirements-inference.txt /opt/abot-build/requirements-inference.txt
ARG CYCLO_COMMIT=uncommitted
ENV CYCLO_COMMIT=${CYCLO_COMMIT} ABOT_UPSTREAM_COMMIT=ee9013cd8341d5424aa722a8cf25e8985a6e673b
ENV PYTHONPATH=/opt/cyclo-training:/abot PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
RUN python /opt/abot-build/training/check_lock.py && python /opt/abot-build/training/build_receipt.py \
    --flash-arch "${FLASH_ATTN_CUDA_ARCHS}" --max-jobs "${MAX_JOBS}"
WORKDIR /abot
ENTRYPOINT ["/opt/abot-env/bin/python", "/opt/cyclo-training/train_run.py"]
