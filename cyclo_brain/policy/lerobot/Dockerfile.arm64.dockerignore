# Build context is the repository root. Dockerfile COPY instructions remain
# the image-content allowlist; these rules prune unrelated and mutable trees
# before BuildKit walks the context.
docker/
orchestrator/
cyclo_data/
interfaces/
docs/
cyclo_brain/docs/
cyclo_brain/policy/groot/
shared/shared/robot_configs/urdf/
shared/shared/robot_configs/ffw_description/
shared/shared/robot_configs/open_manipulator_description/

.git/
**/.git/
**/.venv/
**/__pycache__/
**/*.py[co]
**/.cache/
**/*.log
**/build/
**/install/
**/coverage/
**/dist/
**/node_modules/
**/*.egg-info/
