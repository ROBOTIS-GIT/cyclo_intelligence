# LeRobot Docker Container with Zenoh Communication Support (AMD64)
#
# Engine-only policy worker: s6-overlay supervises engine-process.
# Lifecycle, action processing, and robot command publication live in the
# central Policy Runtime inside the cyclo_intelligence image.
#
# The runtime + s6 services are policy-agnostic and live under
# cyclo_brain/policy/common/. This image only ships the LeRobot deps
# and bakes the common Engine protocol, SDKs, and LeRobot adapter. Optional
# development mounts may shadow these files without changing production.
#
# Build context: repository root
# Usage:         docker build -f cyclo_brain/policy/lerobot/Dockerfile.amd64 \
#                  -t robotis/lerobot-zenoh:1.4.1-amd64 .

# NVIDIA PyTorch base image (Python 3.12 — required by upstream lerobot
# pyproject.toml ``requires-python = ">=3.12"``).
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:24.12-py3
FROM ${BASE_IMAGE}

# GPU architecture build arg (default=use base image PyTorch, blackwell=install nightly cu128)
ARG GPU_ARCH=default

# s6-overlay version (supervises engine-process)
ARG S6_OVERLAY_VERSION=3.2.0.2

ENV DEBIAN_FRONTEND=noninteractive

# Locale
RUN apt-get update && apt-get install -y locales \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=en_US.UTF-8

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    pkg-config \
    ninja-build \
    libglib2.0-0 \
    libegl-mesa0 \
    libegl1-mesa-dev \
    libgl1-mesa-dri \
    libgles2 \
    ffmpeg \
    libusb-1.0-0-dev \
    speech-dispatcher \
    libgeos-dev \
    portaudio19-dev \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# s6-overlay (supervises the Engine worker)
RUN curl -fsSL -o /tmp/s6-overlay-noarch.tar.xz \
      https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz \
    && curl -fsSL -o /tmp/s6-overlay-x86_64.tar.xz \
      https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz \
    && tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz \
    && tar -C / -Jxpf /tmp/s6-overlay-x86_64.tar.xz \
    && rm /tmp/s6-overlay-*.tar.xz

# uv (fast Python package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv

WORKDIR /lerobot

# Virtual env on top of the base image's Python 3.12
RUN uv venv /lerobot/.venv --python python3
ENV VIRTUAL_ENV=/lerobot/.venv
ENV PATH="/lerobot/.venv/bin:$PATH"

# Copy the repository-pinned LeRobot source.
COPY cyclo_brain/policy/lerobot/lerobot/setup.py cyclo_brain/policy/lerobot/lerobot/pyproject.toml cyclo_brain/policy/lerobot/lerobot/README.md cyclo_brain/policy/lerobot/lerobot/MANIFEST.in ./
COPY cyclo_brain/policy/lerobot/lerobot/src/ ./src/

# Install training/inference + VLA extras. Removed: dynamixel/gamepad/
# hopejr/lekiwi/reachy2/kinematics (hardware), dev/test/video_benchmark
# (development), aloha/pusht/phone/libero/metaworld/sarm (simulation).
RUN uv pip install --no-cache ".[dataset,smolvla,xvla,molmoact2,vla_jepa,fastwam,hilserl,async,peft]"

# Blackwell (sm_120) support: override PyTorch with nightly cu128 build
RUN if [ "$GPU_ARCH" = "blackwell" ]; then \
      echo "=== Installing PyTorch nightly (cu128) for Blackwell ===" && \
      uv pip install --no-cache \
        --index-url https://download.pytorch.org/whl/nightly/cu128 \
        torch && \
      uv pip install --no-cache --no-deps \
        --index-url https://download.pytorch.org/whl/nightly/cu128 \
        torchvision torchcodec && \
      python -c "import torch; print(f'PyTorch: {torch.__version__}, Arch: {torch.cuda.get_arch_list()}')"; \
    fi

# Copy the rest of LeRobot (configs, tests, etc.)
COPY cyclo_brain/policy/lerobot/lerobot/ ./

# Zenoh + Engine Python deps.
# IMPORTANT: eclipse-zenoh version MUST match rmw_zenoh_cpp's bundled
# zenoh-c version (1.6.x). Mismatched versions cause service call
# failures despite discovery working.
RUN uv pip install "eclipse-zenoh>=1.6.0,<1.7.0" rosbags>=0.11.0 GitPython>=3.1.18 json5>=0.9.14 pyyaml \
    && mkdir -p /zenoh_sdk /robot_client_sdk /orchestrator_config /policy_runtime /app

# Bake every source dependency required by the Engine worker. Production must
# not depend on a source checkout being bind-mounted into the container.
COPY cyclo_brain/policy/common/s6-services/ /etc/s6-overlay/s6-rc.d/
COPY cyclo_brain/policy/common/runtime/__init__.py cyclo_brain/policy/common/runtime/engine.py cyclo_brain/policy/common/runtime/hf_token_sync.py /policy_runtime/
COPY cyclo_brain/policy/common/runtime/engine_process/ /policy_runtime/engine_process/
COPY cyclo_brain/policy/lerobot/lerobot_engine/ /app/lerobot_engine/
COPY cyclo_brain/policy/lerobot/manifest.yaml /app/policy_manifest.yaml
COPY cyclo_brain/sdk/zenoh_ros2_sdk/ /zenoh_sdk/
COPY cyclo_brain/sdk/robot_client/ /robot_client_sdk/
COPY shared/shared/robot_configs/*.yaml shared/shared/robot_configs/schema.py /orchestrator_config/
RUN rm -rf /etc/s6-overlay/s6-rc.d/main-runtime \
    && rm -f /etc/s6-overlay/s6-rc.d/user/contents.d/main-runtime \
    && chmod +x /etc/s6-overlay/s6-rc.d/engine-process/run

# HuggingFace cache (bind-mounted from compose so weights survive rebuild).
ENV HF_HOME=/root/.cache/huggingface
ENV HF_LEROBOT_HOME=/root/.cache/huggingface/lerobot
ENV TORCH_HOME=/root/.cache/torch

# Zenoh SDK path
ENV ZENOH_SDK_PATH=/zenoh_sdk

ENV ROBOT_CLIENT_SDK_PATH=/robot_client_sdk
ENV ORCHESTRATOR_CONFIG_PATH=/orchestrator_config

# Common runtime dispatch. POLICY_BACKEND drives service names, and
# POLICY_ENGINE_MODULE points at the backend engine package.
ENV POLICY_BACKEND=lerobot
ENV POLICY_ENGINE_MODULE=lerobot_engine

RUN { \
    echo ""; \
    echo "# Cyclo ROS/Zenoh runtime environment."; \
    echo "# For a remote Zenoh router, comment the local line and uncomment the remote example."; \
    echo "export ROS_DOMAIN_ID=30"; \
    echo "export RMW_IMPLEMENTATION=rmw_zenoh_cpp"; \
    echo "export ZENOH_CONFIG_OVERRIDE='transport/shared_memory/enabled=true'"; \
    echo "# export ZENOH_CONFIG_OVERRIDE='transport/shared_memory/enabled=true;mode=\"client\";connect/endpoints=[\"tcp/192.168.60.139:7447\"]'"; \
    } > /tmp/cyclo_bashrc && \
    if [ -f /root/.bashrc ]; then cat /root/.bashrc >> /tmp/cyclo_bashrc; fi && \
    mv /tmp/cyclo_bashrc /root/.bashrc

WORKDIR /lerobot

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD S6_SVSTAT="$(ls /package/admin/s6-*/command/s6-svstat 2>/dev/null | head -1)" \
     && [ -n "$S6_SVSTAT" ] \
     && "$S6_SVSTAT" /run/service/engine-process 2>&1 | grep -q "up" \
     && test -s /run/cyclo/engine-process.ready \
     || exit 1

# s6-overlay init — launches the Engine worker.
ENTRYPOINT ["/init"]
