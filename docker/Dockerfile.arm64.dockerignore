# The main image builds from the repository root. Keep host datasets, model
# checkpoints, caches, and unrelated policy upstreams out of the build context.
*
!orchestrator/
!orchestrator/**
!cyclo_data/
!cyclo_data/**
!interfaces/
!interfaces/**
!shared/
!shared/**

!cyclo_brain/
cyclo_brain/*
!cyclo_brain/policy/
cyclo_brain/policy/*
!cyclo_brain/policy/common/
!cyclo_brain/policy/common/**
!cyclo_brain/policy/lerobot/
cyclo_brain/policy/lerobot/*
!cyclo_brain/policy/lerobot/manifest.yaml
!cyclo_brain/policy/groot/
cyclo_brain/policy/groot/*
!cyclo_brain/policy/groot/manifest.yaml
!cyclo_brain/sdk/
cyclo_brain/sdk/*
!cyclo_brain/sdk/zenoh_ros2_sdk/
!cyclo_brain/sdk/zenoh_ros2_sdk/**
!cyclo_brain/sdk/robot_client/
!cyclo_brain/sdk/robot_client/**
!cyclo_brain/sdk/action_chunk_processing/
!cyclo_brain/sdk/action_chunk_processing/**

!docker/
docker/*
!docker/s6-agent/
!docker/s6-agent/**
!docker/s6-services/
!docker/s6-services/**
!docker/supervisor_api/
!docker/supervisor_api/**
!docker/docker-compose.yml
!docker/docker-compose.override.yml

**/.git
**/.venv
**/__pycache__
**/*.py[co]
**/.cache
**/*.log
**/build
**/install
**/node_modules
**/coverage
**/dist
**/*.egg-info
