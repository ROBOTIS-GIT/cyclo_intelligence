#!/command/with-contenv bash

set -e
rm -f /run/cyclo/policy-runtime.ready /run/cyclo/policy-runtime.sock

exec bash -ic '
set -e

export ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-30}
export RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION:-rmw_zenoh_cpp}
export ZENOH_CONFIG_OVERRIDE=${ZENOH_CONFIG_OVERRIDE:-transport/shared_memory/enabled=true}
export ZENOH_SHM_ENABLED=${ZENOH_SHM_ENABLED:-true}
export ZENOH_TRANSPORT_SHM_ENABLED=${ZENOH_TRANSPORT_SHM_ENABLED:-true}
export PYTHONPATH="/opt/cyclo/policy/common/runtime:/opt/cyclo/policy/common:/opt/cyclo/sdk/zenoh_ros2_sdk:/opt/cyclo/sdk/robot_client:/opt/cyclo/sdk/action_chunk_processing${PYTHONPATH:+:${PYTHONPATH}}"

echo "[policy-runtime] ROS_DOMAIN_ID=${ROS_DOMAIN_ID}"
echo "[policy-runtime] RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION}"
echo "[policy-runtime] ZENOH_CONFIG_OVERRIDE=${ZENOH_CONFIG_OVERRIDE}"

exec python3 -m main_runtime
'
